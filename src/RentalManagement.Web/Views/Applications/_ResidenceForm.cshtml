@model ResidenceFormViewModel

<div class="modal-header">
    <h5 class="modal-title">@(Model.Id is null ? "Add Residence" : "Edit Residence")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form asp-controller="Applications" asp-action="ResidenceForm" method="post" data-ajax-form
      data-refresh-target="#residence-history-container-@Model.ApplicationId"
      data-refresh-url="@Url.Action("ResidenceHistoryPartial", new { applicationId = Model.ApplicationId })">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ApplicationId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LandlordName" class="form-label"></label>
            <input asp-for="LandlordName" class="form-control" />
            <span asp-validation-for="LandlordName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="LandlordPhone" class="form-label"></label>
            <input asp-for="LandlordPhone" class="form-control" />
            <span asp-validation-for="LandlordPhone" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MoveInDate" class="form-label"></label>
            <input asp-for="MoveInDate" class="form-control" />
            <span asp-validation-for="MoveInDate" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="MoveOutDate" class="form-label"></label>
            <input asp-for="MoveOutDate" class="form-control" />
            <span asp-validation-for="MoveOutDate" class="text-danger"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
