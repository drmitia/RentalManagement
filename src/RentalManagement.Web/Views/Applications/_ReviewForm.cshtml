@model ReviewFormViewModel

<div class="modal-header">
    <h5 class="modal-title">Review Application - @Model.UnitLabel</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form asp-controller="Applications" asp-action="Review" method="post" data-ajax-form
      data-refresh-target="#application-details" data-refresh-url="@Url.Action("DetailsPartial", new { id = Model.ApplicationId })">
    <div class="modal-body">
        <input type="hidden" asp-for="ApplicationId" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label d-block">Outcome</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Outcome" id="outcomeApprove" value="Approve" checked />
                <label class="form-check-label" for="outcomeApprove">Approve</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Outcome" id="outcomeReturn" value="Return" />
                <label class="form-check-label" for="outcomeReturn">Return</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="Outcome" id="outcomeDeny" value="Deny" />
                <label class="form-check-label" for="outcomeDeny">Deny</label>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="LeaseStartDate" class="form-label"></label>
            <input asp-for="LeaseStartDate" class="form-control" />
            <span asp-validation-for="LeaseStartDate" class="text-danger"></span>
            <div class="form-text">Only used when approving.</div>
        </div>

        <div class="mb-3">
            <label asp-for="Comment" class="form-label"></label>
            <textarea asp-for="Comment" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Comment" class="text-danger"></span>
            <div class="form-text">Required when returning or denying.</div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Review</button>
    </div>
</form>
