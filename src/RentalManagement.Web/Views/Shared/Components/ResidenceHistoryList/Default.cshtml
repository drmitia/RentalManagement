@model RentalManagement.Web.Models.Applications.ResidenceHistoryListViewModel

@if (Model.IsEditable)
{
    <input type="hidden" name="ResidenceHistoryVersion" value="@Model.ResidenceHistoryVersion" />
}

@if (Model.Entries.Count == 0)
{
    <p class="text-muted">No prior residences added yet.</p>
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Address</th>
                <th>Landlord</th>
                <th>Move-in</th>
                <th>Move-out</th>
                @if (Model.IsEditable)
                {
                    <th></th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr>
                    <td>@entry.Address</td>
                    <td>@entry.LandlordName &middot; @entry.LandlordPhone</td>
                    <td>@entry.MoveInDate.ToString("d")</td>
                    <td>@(entry.MoveOutDate?.ToString("d") ?? "-")</td>
                    @if (Model.IsEditable)
                    {
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("ResidenceForm", "Applications", new { applicationId = Model.ApplicationId, id = entry.Id })">Edit</button>
                            <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("DeleteResidence", "Applications", new { applicationId = Model.ApplicationId, id = entry.Id })">Remove</button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.IsEditable)
{
    <button type="button" class="btn btn-sm btn-primary" data-modal-url="@Url.Action("ResidenceForm", "Applications", new { applicationId = Model.ApplicationId })">Add Residence</button>
}
