@model List<RentalManagement.Domain.Entities.Unit>
@{
    ViewData["Title"] = "Available Units";
}

<h1 class="mb-4">Available Units</h1>

@if (Model.Count == 0)
{
    <p class="text-muted">No units are currently available.</p>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4">
    @foreach (var unit in Model)
    {
        <div class="col">
            <div class="unit-card h-100 d-flex flex-column">
                <div class="unit-card-body">
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <h3 class="unit-card-title">@unit.Property.Name &ndash; Unit @unit.UnitNumber</h3>
                        <span class="unit-card-badge">@unit.UnitType.Name</span>
                    </div>
                    <p class="unit-card-desc">@unit.Property.Address</p>
                    <div class="unit-card-meta">
                        <span class="unit-card-meta-item">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 18v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6M3 18v2M21 18v2M3 12V8a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" /></svg>
                            @(unit.Bedrooms == 0 ? "Studio layout" : unit.Bedrooms == 1 ? "1 Bedroom" : $"{unit.Bedrooms} Bedrooms")
                        </span>
                    </div>
                </div>
                <div class="unit-card-footer">
                    <div class="unit-card-price">@unit.MonthlyRent.ToString("C0")<span>/month</span></div>
                    <form asp-controller="Applications" asp-action="Start" asp-route-unitId="@unit.Id" method="post">
                        <button type="submit" class="unit-card-btn">Apply</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
